  "method": {
    "moving_threshold_mps": 0.3,
    "moving_threshold_source": "tgsim_core.STOP_SPEED = 0.3 m/s, reused by src/tgsim/analyze_events.py; moving_fraction = mean(follower speed >= 0.3 m/s)",
    "speed_mean_definition": "mean of the follower speed series fv (m/s)",
    "spacing_definition": "s = dhw - leader_length (bumper-to-bumper, m); dhw is the raw centre distance and leader_length comes from data/tgsim/manifest.json, the convention of src/tgsim/preprocess_events.py and tgsim_core",
    "accel_rms_definition": "sqrt(mean(a^2)) with a = central difference of the raw follower speed over time (no smoothing), identical to analyze_events.event_style",
    "jerk_rms_smoothed_definition": "sqrt(mean(j^2)) with j = central difference of the Savitzky-Golay smoothed follower speed; SG window = 11 samples (1.1 s), polyorder 2 (analyze_events.JERK_WINDOW), identical to analyze_events.event_style",
    "sparse_rule": "an event is SPARSE / non-interacting when its mean spacing > 20 m; for such an event the IDM interaction term is inactive for most of the record, so it is excluded from the interaction subset",
    "aggregations": {
      "event_mean": "arithmetic mean of the per-event values (each event equal weight)",
      "event_median": "median of the per-event values (across events)",
      "pooled_sample_weighted": "sample-count weighted mean of the per-event values, sum(n_i v_i) / sum(n_i), the *_sample_weighted convention of results/tgsim_analysis.json part 2"
    },
    "effect_size": "rank-biserial r = 2U/(n_a n_b) - 1, U = scipy.stats.mannwhitneyu (group HV-HV vs group HV-AV, two-sided); r > 0 => HV-HV values tend to be larger, r < 0 => HV-AV values tend to be larger; the p-value is the two-sided Mann-Whitney p",
    "power_note": "n = 10 HV-HV vs 8 HV-AV events gives very low power; a non-significant p-value is NOT evidence of no difference",
    "ordering_note": "event-mean and event-median orderings of the two pairs REVERSE for jerk_rms_smoothed (and accel_rms), so BOTH aggregations are reported and must be read together: the mean is pulled by one high-jerk HV-HV event while the median reflects the typical event",
    "source_analysis": "results/tgsim_analysis.json",
    "source_events": "data/tgsim/{HV-HV,HV-AV}/event_*.csv via data/tgsim/manifest.json"
  },
